{
  "name": "MaCoKi Health Suite",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {"ghcr.io/devcontainers/features/node:1": {"version": "22"}},
  "forwardPorts": [8000, 5173],
  "postCreateCommand": "python -m pip install -r backend/requirements.txt && cd frontend && npm install",
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint"]}}
}
